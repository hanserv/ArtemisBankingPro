@model AddBeneficiaryViewModel
@{
    ViewData["Title"] = "Add beneficiary";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Client" asp-controller="Beneficiary" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 m-0"><i class="bi bi-person-plus"></i> Add beneficiary</h2>
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-area="Client" asp-controller="Beneficiary" asp-action="Add" method="post" class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="AccountNumber" class="form-label">Account number</label>
                    <input asp-for="AccountNumber" class="form-control" placeholder="000000000" maxlength="9" />
                    <span asp-validation-for="AccountNumber" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2 mt-4">
                    <a asp-area="Client" asp-controller="Beneficiary" asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-dark px-4 fw-semibold">
                        <i class="bi bi-check-lg"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>