@model List<BeneficiaryViewModel>
@{
    ViewData["Title"] = "Beneficiaries";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Client" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>

        <a asp-area="Client" asp-controller="Beneficiary" asp-action="Add" class="btn btn-dark fw-semibold px-5">
            <i class="bi bi-plus-lg"></i> Add beneficiary
        </a>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-check-circle-fill"></i> @message
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-x-circle-fill"></i> @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">
                <h2 class="fs-5 m-0"><i class="bi bi-people"></i> Beneficiaries</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Account number</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var beneficiary in Model)
                        {
                            <tr>
                                <td>@beneficiary.FullName</td>
                                <td>@beneficiary.AccountNumber</td>
                                <td class="text-end">
                                    <a asp-area="Client" asp-controller="Beneficiary" asp-action="Delete" asp-route-id="@beneficiary.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-people fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">You have no beneficiaries registered.</p>
        </div>
    }
</div>