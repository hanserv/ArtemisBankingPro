@model DeleteBeneficiaryViewModel
@{
    ViewData["Title"] = "Delete Beneficiary";
}

<div class="mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 m-0">
                <i class="bi bi-x-circle"></i> Delete Beneficiary
            </h2>
        </div>

        <div class="card-body text-center py-5">
            @Html.ValidationSummary(excludePropertyErrors: true, "", new { @class = "text-danger text-start" })

            <i class="bi bi-exclamation-triangle text-danger fs-1"></i>

            <form asp-area="Client" asp-controller="Beneficiary" asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="AccountNumber" />

                <p class="fs-5 mt-3 mb-4">
                    Are you sure you want to delete <strong>@Model.FullName</strong> (account <strong>@Model.AccountNumber</strong>) as a beneficiary?
                </p>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-area="Client" asp-controller="Beneficiary" asp-action="Index" class="btn btn-outline-dark px-4">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>

                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-check-circle"></i> Accept
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>