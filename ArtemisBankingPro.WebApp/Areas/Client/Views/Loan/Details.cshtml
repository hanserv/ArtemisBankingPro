@model LoanDetailsViewModel
@{
    ViewData["Title"] = "Loan details";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Client" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-x-circle-fill"></i> @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 fw-bold m-0 text-uppercase">
                <i class="bi bi-cash-stack"></i> Loan @Model.Loan.LoanNumber
            </h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Approved amount</div>
                    <div class="fw-semibold">RD$ @Model.Loan.CapitalAmount.ToString("N2")</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Annual interest rate</div>
                    <div class="fw-semibold">@Model.Loan.AnnualInterestRate.ToString("N2")%</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Term</div>
                    <div class="fw-semibold">@Model.Loan.TermInMonths months</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Status</div>
                    <div>
                        @if (Model.Loan.ClientPaymentStatus == ClientPaymentStatus.UpToDate)
                        {
                            <span class="badge text-bg-success">Up to date</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">In arrears</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h3 class="fs-6 fw-bold text-uppercase text-secondary mb-3">Amortization schedule</h3>

    @if (Model.Installments.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Due date</th>
                            <th>Installment amount</th>
                            <th>Pending amount</th>
                            <th>Payment status</th>
                            <th>Late</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var installment in Model.Installments)
                        {
                            <tr>
                                <td>@installment.InstallmentNumber</td>
                                <td>@installment.DueDate.ToString("MM/dd/yyyy")</td>
                                <td>RD$ @installment.InstallmentAmount.ToString("N2")</td>
                                <td>RD$ @installment.PendingInstallmentAmount.ToString("N2")</td>
                                <td>
                                    @switch (installment.PaymentStatus)
                                    {
                                        case InstallmentStatus.Paid:
                                            <span class="badge text-bg-success">Paid</span>
                                            break;
                                        case InstallmentStatus.PartiallyPaid:
                                            <span class="badge text-bg-warning">Partially paid</span>
                                            break;
                                        default:
                                            <span class="badge text-bg-light border">Pending</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (installment.IsLate)
                                    {
                                        <span class="badge text-bg-danger">Late</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light border">On time</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-clock-history fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">No installments were found for this loan.</p>
        </div>
    }
</div>