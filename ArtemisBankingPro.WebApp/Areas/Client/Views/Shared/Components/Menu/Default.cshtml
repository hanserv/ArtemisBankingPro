<div class="bg-white rounded shadow-sm border">
	<div class="px-3 py-3 border-bottom">
		<h6 class="text-uppercase text-muted fw-bold mb-0">Client Menu</h6>
	</div>

	<div class="list-group list-group-flush">
		<a asp-area="Client" asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-house-door"></i> Home
		</a>

		<a asp-area="Client" asp-controller="Transaction" asp-action="Index" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-arrow-left-right"></i> Transactions
		</a>

		<a asp-area="Client" asp-controller="Transaction" asp-action="Express" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-lightning-charge"></i> Transactions - Express
		</a>

		<a asp-area="Client" asp-controller="Transaction" asp-action="CreditCardPayment" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-credit-card"></i> Transactions - Credit Card
		</a>

		<a asp-area="Client" asp-controller="Transaction" asp-action="LoanPayment" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-cash-stack"></i> Transactions - Loan
		</a>

		<a asp-area="Client" asp-controller="Transaction" asp-action="BeneficiaryTransaction" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-people"></i> Transactions - Beneficiaries
		</a>

		<a asp-area="Client" asp-controller="Beneficiary" asp-action="Index" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-people"></i> Beneficiaries
		</a>

		<a asp-area="Client" asp-controller="Transaction" asp-action="CashAdvance" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-cash-coin"></i> Cash Advance
		</a>

		<a asp-area="Client" asp-controller="Transaction" asp-action="OwnAccountTransfer" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-arrow-left-right"></i> Transfer
		</a>
		
		<form asp-area="" asp-controller="Auth" asp-action="LogOut" method="post">
			<button class="list-group-item list-group-item-action border-0 text-danger">
				<i class="bi bi-box-arrow-right"></i> Sign Out
			</button>
		</form>
	</div>
</div>