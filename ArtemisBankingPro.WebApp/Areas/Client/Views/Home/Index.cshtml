@model ClientHomeViewModel
@{
    ViewData["Title"] = "Home";
}

<div>
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm text-center mt-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center mt-2" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="bg-white border-start border-4 border-primary rounded shadow-sm px-3 py-2 mb-3">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h5 class="fw-bold mb-0">Client Home</h5>
                <small class="text-muted">Welcome Back</small>
            </div>
            <i class="bi bi-house-door text-primary fs-4"></i>
        </div>
    </div>

    @if (!Model.HasAnyProduct)
    {
        <div class="text-center py-5">
            <i class="bi bi-wallet2 fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">You do not have any active financial products.</p>
        </div>
    }
    else
    {
        @if (Model.SavingsAccounts.Count > 0)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white">
                    <h2 class="fs-5 m-0"><i class="bi bi-wallet2"></i> Savings accounts</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Account number</th>
                                <th>Balance</th>
                                <th>Type</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in Model.SavingsAccounts)
                            {
                                <tr>
                                    <td>@account.AccountNumber</td>
                                    <td>RD$ @account.Balance.ToString("N2")</td>
                                    <td><span class="badge text-bg-light border">@account.Type</span></td>
                                    <td class="text-end">
                                        <a asp-area="Client" asp-controller="SavingsAccount" asp-action="Details" asp-route-id="@account.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            <i class="bi bi-eye"></i> View details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (Model.Loans.Count > 0)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white">
                    <h2 class="fs-5 m-0"><i class="bi bi-cash-stack"></i> Loans</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Loan number</th>
                                <th>Capital amount</th>
                                <th>Installments</th>
                                <th>Pending amount</th>
                                <th>Annual rate</th>
                                <th>Term</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var loan in Model.Loans)
                            {
                                <tr>
                                    <td>@loan.LoanNumber</td>
                                    <td>RD$ @loan.CapitalAmount.ToString("N2")</td>
                                    <td>@loan.PaidInstallments / @loan.TotalInstallments</td>
                                    <td>RD$ @loan.PendingAmount.ToString("N2")</td>
                                    <td>@loan.AnnualInterestRate.ToString("N2")%</td>
                                    <td>@loan.TermInMonths months</td>
                                    <td>
                                        @if (loan.ClientPaymentStatus == ClientPaymentStatus.UpToDate)
                                        {
                                            <span class="badge text-bg-success">Up to date</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-danger">In arrears</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-area="Client" asp-controller="Loan" asp-action="Details" asp-route-id="@loan.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            <i class="bi bi-eye"></i> View details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (Model.CreditCards.Count > 0)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white">
                    <h2 class="fs-5 m-0"><i class="bi bi-credit-card"></i> Credit cards</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Card number</th>
                                <th>Credit limit</th>
                                <th>Current debt</th>
                                <th>Expiration</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var card in Model.CreditCards)
                            {
                                <tr>
                                    <td>**** **** **** @card.LastFourDigits</td>
                                    <td>RD$ @card.CreditLimit.ToString("N2")</td>
                                    <td>RD$ @card.CurrentDebt.ToString("N2")</td>
                                    <td>@card.ExpirationDate</td>
                                    <td class="text-end">
                                        <a asp-area="Client" asp-controller="CreditCard" asp-action="Details" asp-route-id="@card.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            <i class="bi bi-eye"></i> View details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>