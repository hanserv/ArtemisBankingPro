@model CreditCardDetailsViewModel
@{
    ViewData["Title"] = "Credit card details";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Client" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-x-circle-fill"></i> @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 fw-bold m-0 text-uppercase">
                <i class="bi bi-credit-card"></i> Card **** **** **** @Model.Card.LastFourDigits
            </h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Credit limit</div>
                    <div class="fw-semibold">RD$ @Model.Card.CreditLimit.ToString("N2")</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Current debt</div>
                    <div class="fw-semibold">RD$ @Model.Card.CurrentDebt.ToString("N2")</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Available credit</div>
                    <div class="fw-semibold">RD$ @Model.Card.AvailableCredit.ToString("N2")</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Expiration</div>
                    <div class="fw-semibold">@Model.Card.ExpirationDate</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="text-muted small">Status</div>
                    <div>
                        @if (Model.Card.Status == CreditCardStatus.Active)
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Cancelled</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h3 class="fs-6 fw-bold text-uppercase text-secondary mb-3">Consumption history</h3>

    @if (Model.Consumptions.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Commerce</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var consumption in Model.Consumptions)
                        {
                            <tr>
                                <td>@consumption.Date.ToString("MM/dd/yyyy hh:mm tt")</td>
                                <td>RD$ @consumption.Amount.ToString("N2")</td>
                                <td>@consumption.CommerceName</td>
                                <td>
                                    @if (consumption.Status == ConsumptionStatus.Approved)
                                    {
                                        <span class="badge text-bg-success">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Rejected</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-clock-history fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">No consumptions were founded for this card.</p>
        </div>
    }
</div>