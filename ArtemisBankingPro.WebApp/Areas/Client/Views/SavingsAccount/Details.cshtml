@model ClientSavingsAccountDetailsViewModel
@{
    ViewData["Title"] = "Account details";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Client" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-x-circle-fill"></i> @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 fw-bold m-0 text-uppercase">
                <i class="bi bi-wallet2"></i> Account @Model.Account.AccountNumber
            </h2>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-md-4">
                    <div class="text-muted small">Balance</div>
                    <div class="fw-semibold">RD$ @Model.Account.Balance.ToString("N2")</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="text-muted small">Type</div>
                    <div class="fw-semibold">@Model.Account.Type</div>
                </div>
            </div>
        </div>
    </div>

    <h3 class="fs-6 fw-bold text-uppercase text-secondary mb-3">Transaction history</h3>

    @if (Model.Transactions.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Type</th>
                            <th>Beneficiary</th>
                            <th>Origin</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model.Transactions)
                        {
                            <tr>
                                <td>@transaction.Date.ToString("MM/dd/yyyy hh:mm tt")</td>
                                <td>RD$ @transaction.Amount.ToString("N2")</td>
                                <td>
                                    @if (transaction.TransactionType == TransactionType.Credit)
                                    {
                                        <span class="badge text-bg-success">Credit</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Debit</span>
                                    }
                                </td>
                                <td>@transaction.Beneficiary</td>
                                <td>@transaction.Origin</td>
                                <td>
                                    @if (transaction.Status == TransactionStatus.Approved)
                                    {
                                        <span class="badge text-bg-success">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Rejected</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-clock-history fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">No transactions were found for this account.</p>
        </div>
    }
</div>