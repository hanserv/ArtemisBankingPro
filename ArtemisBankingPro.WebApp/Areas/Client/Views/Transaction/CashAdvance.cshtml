@model CashAdvanceViewModel
@{
    ViewData["Title"] = "Cash advance";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Client" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 m-0">
                <i class="bi bi-cash-coin"></i> Cash advance
            </h2>
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-area="Client" asp-controller="Transaction" asp-action="CashAdvance" method="post" class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="CreditCardId" class="form-label">Credit card</label>
                    <select asp-for="CreditCardId" class="form-select">
                        <option value="">Select a card</option>
                        @foreach (var card in Model.CardOptions)
                        {
                            <option value="@card.Id">**** @card.LastFourDigits - Available RD$ @card.AvailableCredit.ToString("N2")</option>
                        }
                    </select>
                    <span asp-validation-for="CreditCardId" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="DestinationAccountNumber" class="form-label">Destination account</label>
                    <select asp-for="DestinationAccountNumber" class="form-select">
                        <option value="">Select an account</option>
                        @foreach (var account in Model.AccountOptions)
                        {
                            <option value="@account.AccountNumber">@account.AccountNumber - RD$ @account.Balance.ToString("N2") (@account.Type)</option>
                        }
                    </select>
                    <span asp-validation-for="DestinationAccountNumber" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Amount" class="form-label">Advance amount</label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="Amount" class="form-control" step="0.01" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger"></span>
                    <div class="form-text">A 6.25% interest fee will be added to the requested amount and charged to your credit card.</div>
                </div>

                <div class="col-12 d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-dark px-5 fw-semibold">
                        <i class="bi bi-check-lg"></i> Request advance
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>