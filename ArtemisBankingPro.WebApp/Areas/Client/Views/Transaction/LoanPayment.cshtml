@model ClientLoanPaymentViewModel
@{
    ViewData["Title"] = "Loan payment";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Client" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 m-0">
                <i class="bi bi-cash-stack"></i> Loan payment
            </h2>
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-area="Client" asp-controller="Transaction" asp-action="LoanPayment" method="post" class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="LoanId" class="form-label">Loan to pay</label>
                    <select asp-for="LoanId" class="form-select">
                        <option value="">Select a loan</option>
                        @foreach (var loan in Model.LoanOptions)
                        {
                            <option value="@loan.Id">@loan.LoanNumber - Pending RD$ @loan.PendingAmount.ToString("N2")</option>
                        }
                    </select>
                    <span asp-validation-for="LoanId" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="SourceAccountNumber" class="form-label">Source account</label>
                    <select asp-for="SourceAccountNumber" class="form-select">
                        <option value="">Select an account</option>
                        @foreach (var account in Model.SourceAccountOptions)
                        {
                            <option value="@account.AccountNumber">@account.AccountNumber - RD$ @account.Balance.ToString("N2") (@account.Type)</option>
                        }
                    </select>
                    <span asp-validation-for="SourceAccountNumber" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Amount" class="form-label">Amount to pay</label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="Amount" class="form-control" step="0.01" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-dark px-5 fw-semibold">
                        <i class="bi bi-check-lg"></i> Make payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>