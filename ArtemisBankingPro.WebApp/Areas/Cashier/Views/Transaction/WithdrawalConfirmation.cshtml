@model WithdrawalConfirmationViewModel
@{
    ViewData["Title"] = "Confirm withdrawal";
}

<div>
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 m-0">
                <i class="bi bi-cash"></i> Confirm withdrawal
            </h2>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="text-muted small">Account holder</div>
                    <div class="fw-semibold">@Model.AccountHolderName</div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="text-muted small">Source account number</div>
                    <div class="fw-semibold">@Model.AccountNumber</div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="text-muted small">Amount to withdraw</div>
                    <div class="fw-semibold">RD$ @Model.Amount.ToString("N2")</div>
                </div>
            </div>

            <p class="text-center fw-semibold">Are you sure you want to make this withdrawal?</p>

            <form asp-area="Cashier" asp-controller="Transaction" asp-action="ConfirmWithdrawal" method="post">
                <input type="hidden" asp-for="AccountNumber" />
                <input type="hidden" asp-for="AccountHolderName" />
                <input type="hidden" asp-for="Amount" />

                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a asp-area="Cashier" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-5 fw-semibold">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-dark px-5 fw-semibold">
                        <i class="bi bi-check-lg"></i> Confirm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>