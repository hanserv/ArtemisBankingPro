@model WithdrawalViewModel
@{
    ViewData["Title"] = "Withdrawal";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Cashier" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 m-0">
                <i class="bi bi-cash"></i> Withdrawal
            </h2>
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-area="Cashier" asp-controller="Transaction" asp-action="Withdrawal" method="post" class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="AccountNumber" class="form-label">Source account number</label>
                    <input asp-for="AccountNumber" class="form-control" placeholder="000000000" />
                    <span asp-validation-for="AccountNumber" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Amount" class="form-label">Amount to withdraw</label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="Amount" class="form-control" step="0.01" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-dark px-5 fw-semibold">
                        <i class="bi bi-check-lg"></i> Make withdrawal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>