@model ThirdPartyTransactionConfirmationViewModel
@{
    ViewData["Title"] = "Confirm transaction";
}

<div>
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 m-0">
                <i class="bi bi-arrow-left-right"></i> Confirm transaction
            </h2>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Source account holder</div>
                    <div class="fw-semibold">@Model.SourceAccountHolderName</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Source account number</div>
                    <div class="fw-semibold">@Model.SourceAccountNumber</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Destination account holder</div>
                    <div class="fw-semibold">@Model.DestinationAccountHolderName</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Destination account number</div>
                    <div class="fw-semibold">@Model.DestinationAccountNumber</div>
                </div>
                <div class="col-12">
                    <div class="text-muted small">Transaction amount</div>
                    <div class="fw-semibold">RD$ @Model.Amount.ToString("N2")</div>
                </div>
            </div>

            <p class="text-center fw-semibold">Are you sure you want to make this transaction?</p>

            <form asp-area="Cashier" asp-controller="Transaction" asp-action="ConfirmThirdPartyTransaction" method="post">
                <input type="hidden" asp-for="SourceAccountNumber" />
                <input type="hidden" asp-for="SourceAccountHolderName" />
                <input type="hidden" asp-for="DestinationAccountNumber" />
                <input type="hidden" asp-for="DestinationAccountHolderName" />
                <input type="hidden" asp-for="Amount" />

                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a asp-area="Cashier" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-5 fw-semibold">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-dark px-5 fw-semibold">
                        <i class="bi bi-check-lg"></i> Confirm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>