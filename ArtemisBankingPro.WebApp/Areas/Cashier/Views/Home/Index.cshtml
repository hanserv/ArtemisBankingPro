@model CashierDashboardViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div>
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm text-center mt-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center mt-2" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="bg-white border-start border-4 border-primary rounded shadow-sm px-3 py-2 mb-3">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h5 class="fw-bold mb-0">Cashier Home</h5>
                <small class="text-muted">Today's Indicators</small>
            </div>

            <i class="bi bi-house-door text-primary fs-4"></i>
        </div>
    </div>

    @if (Model is null)
    {
        <div class="text-center py-5">
            <i class="bi bi-exclamation-triangle fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">
                The dashboard indicators could not be loaded.
            </p>
        </div>
    }
    else
    {
        <div class="card border-start border-1 border-success shadow-sm">
            <div class="card-header bg-white border-0 pt-3 pb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left-right text-success"></i>
                    <span class="fw-semibold">Today's Activity</span>
                </div>
            </div>

            <div class="card-body pt-2">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="card border-start border-1 border-success shadow-sm h-100">
                            <div class="card-body text-center py-3">
                                <i class="bi bi-arrow-left-right fs-3 text-success"></i>

                                <div class="fw-bold fs-4 mt-1">
                                    @Model.TodayTransactions
                                </div>

                                <small class="text-muted">
                                    Transactions
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="card border-start border-1 border-primary shadow-sm h-100">
                            <div class="card-body text-center py-3">
                                <i class="bi bi-credit-card fs-3 text-primary"></i>

                                <div class="fw-bold fs-4 mt-1">
                                    @Model.TodayPayments
                                </div>

                                <small class="text-muted">
                                    Payments
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="card border-start border-1 border-success shadow-sm h-100">
                            <div class="card-body text-center py-3">
                                <i class="bi bi-piggy-bank fs-3 text-success"></i>

                                <div class="fw-bold fs-4 mt-1">
                                    @Model.TodayDeposits
                                </div>

                                <small class="text-muted">
                                    Deposits
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="card border-start border-1 border-warning shadow-sm h-100">
                            <div class="card-body text-center py-3">
                                <i class="bi bi-cash fs-3 text-warning"></i>

                                <div class="fw-bold fs-4 mt-1">
                                    @Model.TodayWithdrawals
                                </div>

                                <small class="text-muted">
                                    Withdrawals
                                </small>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
</div>