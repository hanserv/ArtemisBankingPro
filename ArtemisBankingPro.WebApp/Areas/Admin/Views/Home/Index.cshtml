@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div>
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm text-center mt-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center mt-2" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i> @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="bg-white border-start border-4 border-primary rounded shadow-sm px-3 py-2 mb-3">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h5 class="fw-bold mb-0">Admin Home</h5>
                <small class="text-muted">General Indicators</small>
            </div>
            <i class="bi bi-house-door text-primary fs-4"></i>
        </div>
    </div>

    @if (Model is null)
    {
        <div class="text-center py-5">
            <i class="bi bi-exclamation-triangle fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">
                The dashboard indicators could not be loaded.
            </p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-12 col-xl-8">
                <div class="card border-1 border-success shadow-sm h-100">
                    <div class="card-header bg-white border-0 pt-3 pb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left-right text-success"></i>
                            <span class="fw-semibold">Transactions</span>
                        </div>
                    </div>

                    <div class="card-body pt-2">
                        <div class="row g-0 text-center">
                            <div class="col-6 col-md-3 border-end">
                                <div class="fw-bold fs-4">@Model.TotalTransactions</div>
                                <small class="text-muted">Total Transactions</small>
                            </div>

                            <div class="col-6 col-md-3 border-end">
                                <div class="fw-bold fs-4">@Model.TodayTransactions</div>
                                <small class="text-muted">Today's Transactions</small>
                            </div>

                            <div class="col-6 col-md-3 border-end mt-3 mt-md-0">
                                <div class="fw-bold fs-4">@Model.TotalPayments</div>
                                <small class="text-muted">Total Payments</small>
                            </div>

                            <div class="col-6 col-md-3 mt-3 mt-md-0">
                                <div class="fw-bold fs-4">@Model.TodayPayments</div>
                                <small class="text-muted">Today's Payments</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card border-1 border-primary shadow-sm h-100">
                    <div class="card-header bg-white border-0 pt-3 pb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-people text-primary"></i>
                            <span class="fw-semibold">Clients</span>
                        </div>
                    </div>

                    <div class="card-body pt-2 d-flex align-items-center">
                        <div class="row g-0 text-center w-100">
                            <div class="col-6 border-end">
                                <div class="fw-bold fs-4 text-success">
                                    @Model.ActiveClients
                                </div>
                                <small class="text-muted">Active</small>
                            </div>

                            <div class="col-6">
                                <div class="fw-bold fs-4 text-danger">
                                    @Model.InactiveClients
                                </div>
                                <small class="text-muted">Inactive</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="card border-1 border-dark shadow-sm mb-3">
            <div class="card-header bg-white border-0 pt-3 pb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-wallet2 text-success"></i>
                    <span class="fw-semibold">Financial Products</span>
                </div>
            </div>

            <div class="card-body pt-2">
                <div class="row g-0 text-center">
                    <div class="col-6 col-md-3 border-end">
                        <div class="fw-bold fs-4">@Model.TotalFinancialProducts</div>
                        <small class="text-muted">Total Products</small>
                    </div>

                    <div class="col-6 col-md-3 border-end">
                        <div class="fw-bold fs-4">@Model.ActiveSavingsAccounts</div>
                        <small class="text-muted">Savings Accounts</small>
                    </div>

                    <div class="col-6 col-md-3 border-end mt-3 mt-md-0">
                        <div class="fw-bold fs-4">@Model.ActiveLoans</div>
                        <small class="text-muted">Active Loans</small>
                    </div>

                    <div class="col-6 col-md-3 mt-3 mt-md-0">
                        <div class="fw-bold fs-4">@Model.ActiveCreditCards</div>
                        <small class="text-muted">Active Credit Cards</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-1 border-warning shadow-sm">
            <div class="card-header bg-white border-0 pt-3 pb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-exclamation text-warning"></i>
                    <span class="fw-semibold">Risk</span>
                </div>
            </div>

            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted">Average Debt per Client</small>
                        <div class="fw-bold fs-4">
                            RD$ @Model.AverageDebtPerClient.ToString("N2")
                        </div>
                    </div>

                    <i class="bi bi-graph-up-arrow fs-3 text-warning"></i>
                </div>
            </div>
        </div>
    }
</div>