@model SavingsAccountListViewModel
@{
    ViewData["Title"] = "Savings account management";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>

        <a asp-area="Admin" asp-controller="SavingsAccount" asp-action="Assign" class="btn btn-dark fw-semibold px-5">
            <i class="bi bi-plus-lg"></i> Assign savings account
        </a>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-check-circle-fill"></i> @message
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-x-circle-fill"></i> @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-area="Admin" asp-controller="SavingsAccount" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-6 col-md-3">
                    <label asp-for="Filter.Status" class="form-label">Status</label>
                    <select asp-for="Filter.Status" class="form-select" asp-items="Html.GetEnumSelectList<SavingsAccountStatus>()">
                        <option value="">All</option>
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label asp-for="Filter.Type" class="form-label">Type</label>
                    <select asp-for="Filter.Type" class="form-select" asp-items="Html.GetEnumSelectList<SavingsAccountType>()">
                        <option value="">All</option>
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="Filter.Identification" class="form-label">Client identification</label>
                    <input asp-for="Filter.Identification" class="form-control" placeholder="001-0000000-0" />
                </div>

                <div class="col-12 col-md-3 d-flex gap-2">
                    <a asp-area="Admin" asp-controller="SavingsAccount" asp-action="Index" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-x-circle"></i> Clear filters
                    </a>
                    <button type="submit" class="btn btn-dark flex-fill">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Accounts.Items.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">
                <h2 class="fs-5 m-0">
                    <i class="bi bi-wallet2"></i> Savings accounts
                </h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Account number</th>
                            <th>Client</th>
                            <th>Balance</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model.Accounts.Items)
                        {
                            <tr>
                                <td>@account.AccountNumber</td>
                                <td>@account.ClientFullName</td>
                                <td>RD$ @account.Balance.ToString("N2")</td>
                                <td>
                                    <span class="badge text-bg-light border">@account.Type</span>
                                </td>
                                <td>
                                    @if (account.Status == SavingsAccountStatus.Active)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Cancelled</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="SavingsAccount" asp-action="Details" asp-route-id="@account.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View details
                                    </a>

                                    @if (account.Status == SavingsAccountStatus.Active && account.Type == SavingsAccountType.Secondary)
                                    {
                                        <a asp-area="Admin" asp-controller="SavingsAccount" asp-action="Cancel" asp-route-id="@account.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle"></i> Cancel
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Accounts.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (var i = 1; i <= Model.Accounts.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Accounts.Page ? "active" : "")">
                            <a class="page-link"
                               asp-area="Admin" asp-controller="SavingsAccount" asp-action="Index"
                               asp-route-Filter.Status="@Model.Filter.Status"
                               asp-route-Filter.Type="@Model.Filter.Type"
                               asp-route-Filter.Identification="@Model.Filter.Identification"
                               asp-route-Filter.Page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-wallet2 fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">No savings accounts were found with the selected filters.</p>
        </div>
    }
</div>