@model AssignLoanSelectClientViewModel
@{
    ViewData["Title"] = "Assign loan";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Admin" asp-controller="Loan" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-light rounded p-2">
                    <i class="bi bi-graph-up fs-4"></i>
                </div>

                <div>
                    <div class="fw-semibold">Average client debt</div>
                </div>
            </div>

            <div class="text-end">
                <div class="fs-5 fw-bold">RD$ @Model.SystemAverageDebt.ToString("N2")</div>
            </div>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-area="Admin" asp-controller="Loan" asp-action="Assign" method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-6">
                    <label asp-for="Identification" class="form-label">Client identification</label>
                    <input asp-for="Identification" class="form-control" placeholder="001-0000000-0" />
                </div>

                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark flex-fill">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <form asp-area="Admin" asp-controller="Loan" asp-action="Assign" method="post">
        <input type="hidden" asp-for="Identification" />

        @if (Model.Clients.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h2 class="fs-5 m-0">
                        <i class="bi bi-people"></i> Eligible clients
                    </h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Identification</th>
                                <th>Full name</th>
                                <th>Email</th>
                                <th>Total debt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var client in Model.Clients)
                            {
                                <tr>
                                    <td>
                                        <input type="radio" name="SelectedClientId" value="@client.Id" class="form-check-input" />
                                    </td>
                                    <td>@client.Identification</td>
                                    <td>@client.FullName</td>
                                    <td>@client.Email</td>
                                    <td>RD$ @client.TotalDebt.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-dark px-5 fw-semibold">
                    Next step <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-people fs-1 text-secondary"></i>
                <p class="mt-3 mb-0 text-secondary">No eligible clients were found.</p>
            </div>
        }
    </form>
</div>