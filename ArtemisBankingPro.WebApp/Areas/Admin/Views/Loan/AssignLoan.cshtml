@model AssignLoanViewModel
@{
    ViewData["Title"] = "Assign loan";
    var allowedTerms = new[] { 6, 12, 18, 24, 30, 36, 42, 48, 54, 60 };
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Admin" asp-controller="Loan" asp-action="Assign" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 m-0">
                <i class="bi bi-cash-coin"></i> New loan
            </h2>
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-area="Admin" asp-controller="Loan" asp-action="AssignLoan" method="post" class="row g-3">
                <input type="hidden" asp-for="ClientId" />
                <input type="hidden" asp-for="RiskWarningAccepted" />

                <div class="col-12 col-md-4">
                    <label asp-for="TermInMonths" class="form-label">Term</label>
                    <select asp-for="TermInMonths" class="form-select">
                        <option value="">Select a term</option>
                        @foreach (var term in allowedTerms)
                        {
                            <option value="@term">@term months</option>
                        }
                    </select>
                    <span asp-validation-for="TermInMonths" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="CapitalAmount" class="form-label">Loan amount</label>
                    <div class="input-group">
                        <span class="input-group-text">RD$</span>
                        <input asp-for="CapitalAmount" class="form-control" step="0.01" />
                    </div>
                    <span asp-validation-for="CapitalAmount" class="text-danger"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="AnnualInterestRate" class="form-label">Annual interest rate</label>
                    <div class="input-group">
                        <input asp-for="AnnualInterestRate" class="form-control" step="0.01" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="AnnualInterestRate" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-dark px-5 fw-semibold">
                        <i class="bi bi-check-lg"></i> Assign loan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>