@model LoanListViewModel
@{
    ViewData["Title"] = "Loan management";
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>

        <a asp-area="Admin" asp-controller="Loan" asp-action="Assign" class="btn btn-dark fw-semibold px-5">
            <i class="bi bi-plus-lg"></i> Assign loan
        </a>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-check-circle-fill"></i> @message
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-x-circle-fill"></i> @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-area="Admin" asp-controller="Loan" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-6 col-md-3">
                    <label asp-for="Filter.Status" class="form-label">Status</label>
                    <select asp-for="Filter.Status" class="form-select" asp-items="Html.GetEnumSelectList<LoanStatus>()">
                        <option value="">All</option>
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="Filter.Identification" class="form-label">Client identification</label>
                    <input asp-for="Filter.Identification" class="form-control" placeholder="001-0000000-0" />
                </div>

                <div class="col-12 col-md-3 d-flex gap-2">
                    <a asp-area="Admin" asp-controller="Loan" asp-action="Index" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-x-circle"></i> Clear filters
                    </a>
                    <button type="submit" class="btn btn-dark flex-fill">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Loans.Items.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">
                <h2 class="fs-5 m-0">
                    <i class="bi bi-cash-coin"></i> Loans
                </h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Loan number</th>
                            <th>Client</th>
                            <th>Capital amount</th>
                            <th>Installments</th>
                            <th>Pending amount</th>
                            <th>Annual rate</th>
                            <th>Term</th>
                            <th>Loan status</th>
                            <th>Client status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.Loans.Items)
                        {
                            <tr>
                                <td>@loan.LoanNumber</td>
                                <td>@loan.ClientFullName</td>
                                <td>RD$ @loan.CapitalAmount.ToString("N2")</td>
                                <td>@loan.PaidInstallments / @loan.TotalInstallments</td>
                                <td>RD$ @loan.PendingAmount.ToString("N2")</td>
                                <td>@loan.AnnualInterestRate.ToString("N2")%</td>
                                <td>@loan.TermInMonths months</td>
                                <td>
                                    @if (loan.Status == LoanStatus.Active)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Completed</span>
                                    }
                                </td>
                                <td>
                                    @if (loan.ClientPaymentStatus == ClientPaymentStatus.UpToDate)
                                    {
                                        <span class="badge text-bg-success">Up to date</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">In arrears</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="Loan" asp-action="Details" asp-route-id="@loan.Id"
                                       class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-eye"></i> View details
                                    </a>

                                    @if (loan.Status == LoanStatus.Active)
                                    {
                                        <a asp-area="Admin" asp-controller="Loan" asp-action="Edit" asp-route-id="@loan.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                @for (var i = 1; i <= Model.Loans.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Loans.Page ? "active" : "")">
                        <a class="page-link"
                           asp-area="Admin" asp-controller="Loan" asp-action="Index"
                           asp-route-Filter.Status="@Model.Filter.Status"
                           asp-route-Filter.Identification="@Model.Filter.Identification"
                           asp-route-Filter.Page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cash-coin fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">No loans were found with the selected filters.</p>
        </div>
    }
</div>