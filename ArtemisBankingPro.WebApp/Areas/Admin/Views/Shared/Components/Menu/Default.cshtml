<div class="bg-white rounded shadow-sm border">
	<div class="px-3 py-3 border-bottom">
		<h6 class="text-uppercase text-muted fw-bold mb-0">Admin Menu</h6>
	</div>

	<div class="list-group list-group-flush">
		<a asp-area="Admin" asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-house-door"></i> Home
		</a>

		<a asp-area="Admin" asp-controller="User" asp-action="Index" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-person-gear"></i> User management
		</a>

		<a asp-area="Admin" asp-controller="Loan" asp-action="Index" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-cash-coin"></i> Loan management
		</a>

		<a asp-area="Admin" asp-controller="CreditCard" asp-action="Index" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-credit-card"></i> Credit Card management
		</a>

		<a asp-area="Admin" asp-controller="SavingsAccount" asp-action="Index" class="list-group-item list-group-item-action border-0">
			<i class="bi bi-wallet2"></i> Savings Account management
		</a>
		
		<form asp-area="" asp-controller="Auth" asp-action="LogOut" method="post">
			<button class="list-group-item list-group-item-action border-0 text-danger">
				<i class="bi bi-box-arrow-right"></i> Sign Out
			</button>
		</form>
	</div>
</div>