@model ChangeUserStatusViewModel
@{
    ViewData["Title"] = Model.IsActive ? "Activate User" : "Deactivate User";
}

<div class="mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 m-0">
                <i class="bi @(Model.IsActive ? "bi-toggle-off" : "bi-toggle-on")"></i>
                @(Model.IsActive ? "Activate User" : "Deactivate User")
            </h2>
        </div>

        <div class="card-body text-center py-5">
            @Html.ValidationSummary(excludePropertyErrors: true, "", new { @class = "text-danger text-start" })
            <form asp-area="Admin" asp-controller="User" asp-action="ChangeStatus" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="IsActive" />

                <p class="fs-5 mt-3 mb-4">
                    Are you sure you want to @(Model.IsActive ? "activate" : "deactivate") the user <strong>@Model.FullName</strong>?
                </p>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-outline-dark px-4">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>

                    <button type="submit" class="btn @(Model.IsActive ? "btn-success" : "btn-danger") px-4">
                        <i class="bi bi-check-circle"></i> Accept
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>