@using System.Security.Claims
@model UserListViewModel
@{
    ViewData["Title"] = "User management";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div>
    <div class="d-flex justify-content-between gap-2 mb-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark fw-semibold">
            <i class="bi bi-arrow-left"></i> Go back
        </a>

        <a asp-area="Admin" asp-controller="User" asp-action="Create" class="btn btn-dark fw-semibold px-5">
            <i class="bi bi-plus-lg"></i> Create user
        </a>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-check-circle-fill"></i> @message
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="justify-content-center my-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm text-center" role="alert">
                <i class="bi bi-x-circle-fill"></i> @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-area="Admin" asp-controller="User" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-6 col-md-4">
                    <label asp-for="Filter.Role" class="form-label">Role</label>
                    <select asp-for="Filter.Role" class="form-select" asp-items="Html.GetEnumSelectList<UserType>()">
                        <option value="">All</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 d-flex gap-2">
                    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-outline-secondary flex-fill">
                        <i class="bi bi-x-circle"></i> Clear filters
                    </a>
                    <button type="submit" class="btn btn-dark flex-fill">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Users.Items.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Identification</th>
                            <th>First name</th>
                            <th>Last name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users.Items)
                        {
                            <tr>
                                <td>@user.UserName</td>
                                <td>@user.Identification</td>
                                <td>@user.FirstName</td>
                                <td>@user.LastName</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge text-bg-light border">@user.Role</span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (user.Id != currentUserId)
                                    {
                                        <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>

                                        @if (user.IsActive)
                                        {
                                            <a asp-area="Admin" asp-controller="User" asp-action="ChangeStatus"
                                               asp-route-id="@user.Id" asp-route-isActive="false"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-toggle-on"></i> Deactivate
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-area="Admin" asp-controller="User" asp-action="ChangeStatus"
                                               asp-route-id="@user.Id" asp-route-isActive="true"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-toggle-off"></i> Activate
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">No actions available</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Users.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    @for (var i = 1; i <= Model.Users.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Users.Page ? "active" : "")">
                            <a class="page-link" asp-area="Admin" asp-controller="User" asp-action="Index" asp-route-Filter.Role="@Model.Filter.Role" asp-route-Filter.Page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-people fs-1 text-secondary"></i>
            <p class="mt-3 mb-0 text-secondary">No users were found with the selected filters.</p>
        </div>
    }
</div>