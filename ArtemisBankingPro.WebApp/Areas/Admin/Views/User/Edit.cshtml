@model UpdateUserViewModel
@{
    ViewData["Title"] = "Update User";
}

<div>
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h2 class="fs-5 fw-bold m-0 text-center text-uppercase">Update User</h2>
        </div>
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <form asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Role" />

                <div class="row my-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label">Role:</label>
                        <input type="text" class="form-control" value="@Model.Role" disabled />
                        <div class="form-text">The role cannot be changed after creation.</div>
                    </div>
                </div>

                <div class="row my-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="FirstName" class="form-label">First name:</label>
                        <input asp-for="FirstName" class="form-control" placeholder="Hanser" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-sm-6 mt-3 mt-sm-0">
                        <label asp-for="LastName" class="form-label">Last name:</label>
                        <input asp-for="LastName" class="form-control" placeholder="Ventura" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row my-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="Identification" class="form-label">Identification:</label>
                        <input asp-for="Identification" class="form-control" placeholder="001-0000000-0" />
                        <span asp-validation-for="Identification" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-sm-6 mt-3 mt-sm-0">
                        <label asp-for="Email" class="form-label">Email:</label>
                        <input asp-for="Email" class="form-control" placeholder="hanser@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row my-3">
                    <div class="col-12">
                        <label asp-for="UserName" class="form-label">Username:</label>
                        <input asp-for="UserName" class="form-control" placeholder="hanser.11" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row my-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="Password" class="form-label">New password:</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <div class="form-text">Leave blank to keep the current password.</div>
                    </div>
                    <div class="col-12 col-sm-6 mt-3 mt-sm-0">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm new password:</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                @if (Model.Role == "Client")
                {
                    <div class="row my-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="AdditionalAmount" class="form-label">Additional amount:</label>
                            <div class="input-group">
                                <span class="input-group-text">RD$</span>
                                <input asp-for="AdditionalAmount" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="AdditionalAmount" class="text-danger"></span>
                            <div class="form-text">Optional. Will be credited to the client's principal savings account.</div>
                        </div>
                    </div>
                }

                <div class="mt-3 d-flex justify-content-end gap-2">
                    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-outline-dark">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-dark px-4">
                        <i class="bi bi-floppy"></i> Save changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>