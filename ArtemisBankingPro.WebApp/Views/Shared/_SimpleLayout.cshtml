<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ArtemisBankingPro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <span class="navbar-brand fs-5 fw-semibold fst-italic ms-md-4">
                    <i class="bi bi-bank fs-3"></i> <span class="text-primary">Artemis</span><span class="text-white">Banking</span><span class="text-danger">Pro</span>
                </span>
            </div>
        </nav>
    </header>
    <main role="main" class="container flex-grow-1 py-3">
        @RenderBody()
    </main>
    <footer class="bg-dark text-white">
        <div class="container text-center py-3">&copy; @DateTime.UtcNow.Year - ArtemisBankingPro</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>