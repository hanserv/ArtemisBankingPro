<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArtemisBankingPro</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArtemisBankingPro.WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" asp-append-version="true">
    @* <link rel="icon" type="image/png" href="~/Images/logo.png" /> *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a asp-area="" asp-controller="Auth" asp-action="Login" class="navbar-brand fs-5 fw-semibold fst-italic ms-md-4"><i class="bi bi-bank fs-3"></i> <span class="text-primary">Artemis</span><span class="text-white">Banking</span><span class="text-danger">Pro</span></a>
            </div>
        </nav>
    </header>

    <div class="container-fluid flex-grow-1 py-3">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="row g-4 mx-md-3">

                <main role="main" class="col-lg-9 pb-3 order-2 order-lg-1">
                    @RenderBody()
                </main>

                <aside class="col-lg-3 order-1 order-lg-2">
                    @await Component.InvokeAsync("Menu")
                </aside>

            </div>
        }
        else
        {
            <main role="main" class="container pb-3">
                @RenderBody()
            </main>
        }
    </div>

    <footer class="bg-dark text-white">
        <div class="container text-center py-1">
            <ul class="nav flex-column flex-sm-row justify-content-center border-bottom pb-1 mb-3">
                <li class="nav-item">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link text-white px-2">RealEstateApp</a>
                </li>
            </ul>
            &copy; @DateTime.UtcNow.Year - ArtemisBankingPro
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/user-form.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
