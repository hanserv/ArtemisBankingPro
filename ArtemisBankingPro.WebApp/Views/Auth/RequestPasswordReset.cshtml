@model RequestPasswordResetViewModel
@{
	ViewData["Title"] = "Request Password Reset";
}

<div class="mb-5 d-flex justify-content-center">
	<div class="card shadow-sm border-0 col-12 col-lg-6">
		<div class="card-header bg-dark text-white">
			<h2 class="fs-4 m-0 text-center">Request Password Reset</h2>
		</div>

		<div class="card-body bg-white p-3">
			@Html.ValidationSummary(excludePropertyErrors: true, "", new { @class = "text-danger" })
			<form asp-area="" asp-controller="Auth" asp-action="RequestPasswordReset" method="post">
				<div class="mb-2">
					<label asp-for="UserName" class="form-label fw-semibold">UserName:</label>
					<input asp-for="UserName" class="form-control" />
					<span asp-validation-for="UserName" class="text-danger"></span>
				</div>

				<div class="d-flex col-12 gap-2 justify-content-end pt-1">
					<a asp-area="" asp-controller="Auth" asp-action="Login" class="btn btn-outline-dark px-4 pt-2 fw-semibold">
						<i class="bi bi-arrow-left"></i> Go back
					</a>
					<button type="submit" class="btn btn-dark px-5 pt-2 fw-semibold">Send request</button>
				</div>
			</form>
		</div>
	</div>
</div>