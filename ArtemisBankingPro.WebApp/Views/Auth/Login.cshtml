@model LoginViewModel
@{
	ViewData["Title"] = "Login Page";
}

<div class="d-flex justify-content-center bg-light">
	<div class="card shadow-sm p-4 col-lg-6 col-12 border-1 border-dark-subtle">
		<h1 class="fs-4 fw-bold mb-1 text-center">ArtemisBankingPro | Login</h1>

		@if (TempData["Message"] is string message)
		{
			<div class="row justify-content-center mt-2">
				<div class="col-12">
					<div class="alert alert-success alert-dismissible fade show shadow-sm text-center" role="alert">
						<i class="bi bi-check-circle-fill me-2"></i> @message
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				</div>
			</div>
		}

		@if (TempData["ErrorMessage"] is string errorMessage)
		{
			<div class="row justify-content-center mt-2">
				<div class="col-12">
					<div class="alert alert-danger alert-dismissible fade show shadow-sm text-center" role="alert">
						<i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				</div>
			</div>
		}

		@Html.ValidationSummary(true, "", new { @class = "text-danger" })
		<form asp-area="" asp-controller="Auth" asp-action="Login" method="post">
			<div class="col-12">
				<label asp-for="UserName" class="form-label">Username:</label>
				<input asp-for="UserName" class="form-control" placeholder="hanser" />
				<span asp-validation-for="UserName" class="text-danger"></span>
			</div>

			<div class="col-12 mt-2">
				<label asp-for="Password" class="form-label">Password:</label>
				<input asp-for="Password" class="form-control" placeholder="••••••••" />
				<span asp-validation-for="Password" class="text-danger"></span>
			</div>

			<div class="d-flex gap-2 mt-4">
				<button type="submit" class="btn btn-dark flex-grow-1 border-1 border-success-subtle"><i class="bi bi-box-arrow-in-right"></i> Login</button>
			</div>
		</form>

		<div class="d-flex flex-column gap-2 text-center mt-2">
			<p class="text-muted mb-0 fs-6">
				<a asp-controller="Auth" asp-action="RequestPasswordReset"
				   class="text-secondary text-decoration-underline small">Reset password</a>
			</p>
		</div>
	</div>
</div>
