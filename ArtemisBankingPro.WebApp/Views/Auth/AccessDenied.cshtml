@using System.Security.Claims
@{
	ViewData["Title"] = "Access Denied";
	Layout = "_SimpleLayout";
	var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
}

<div class="d-flex justify-content-center">
	<div class="card shadow-sm border-0 col-12 col-md-6">
		<div class="card-header bg-dark text-white">
			<h2 class="fs-4 m-0 text-center">Access Denied</h2>
		</div>

		<div class="card-body bg-white p-3">
			<div class="d-flex gap-2 flex-column text-center">
				<i class="bi bi-x-circle-fill text-danger display-3"></i>
				<h5 class="fs-3 fw-semibold">You do not have permission to access this section.</h5>

				<div class="col-12 d-flex justify-content-center">
					<a asp-area="@role" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark col-12 col-md-4 fw-semibold">Go Home</a>
				</div>
			</div>
		</div>
	</div>
</div>